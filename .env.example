# Copy to .env and fill in. Never commit the real .env file.

# MongoDB — local Docker default shown; for deployment use a MongoDB Atlas
# free M0 cluster connection string (mongodb+srv://user:pass@cluster.../).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=stockdb

# Free token from https://huggingface.co/settings/tokens (role: Read).
# Sentiment/summarization silently fall back without one.
HF_API_TOKEN=

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed Vercel URL here once you have it, e.g.:
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000
