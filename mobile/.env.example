# Copy to .env and fill in.
# Base URL of the FastAPI backend (app/main.py).
# - iOS Simulator: http://127.0.0.1:8123 works directly.
# - Android Emulator: use http://10.0.2.2:8123 instead of localhost.
# - Physical device via Expo Go: use your computer's LAN IP, e.g. http://192.168.1.10:8123.
# - Deployed backend: use your Render URL, e.g. https://stock-predictor-api.onrender.com
EXPO_PUBLIC_API_BASE=http://127.0.0.1:8123
